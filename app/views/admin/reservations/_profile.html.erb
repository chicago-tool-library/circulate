<% content_for :header do %>
  <%= breadcrumbs "Reservations", admin_reservations_path %>
  <%= index_header @reservation.name do %>
    <%= link_to "Edit", edit_admin_reservation_path(@reservation), class: "btn" %>

    <% if @reservation.manager.can? :request %>
      <%= button_to "Request", admin_reservation_status_path(@reservation), method: :patch, params: {event: "request"}, class: "btn" %>

    <% elsif @reservation.manager.can? :build %>
      <%= button_to "Start Building", admin_reservation_status_path(@reservation), method: :patch, params: {event: "build"}, class: "btn" %>

    <% elsif @reservation.manager.can? :ready %>
      <%= button_to "Ready for Pickup", admin_reservation_status_path(@reservation), method: :patch, params: {event: "ready"}, class: "btn" %>

    <% elsif @reservation.manager.can? :borrow %>
      <%= button_to "Check out", admin_reservation_status_path(@reservation), method: :patch, params: {event: "borrow"}, class: "btn" %>

    <% elsif @reservation.manager.borrowed? %>
      <% if @reservation.manager.can? :check_in %>
        <%= button_to "Complete Check-in", admin_reservation_status_path(@reservation), method: :patch, params: {event: "check_in"}, class: "btn" %>
      <% end %>
      <%= button_to "Mark Unresolved", admin_reservation_status_path(@reservation), method: :patch, params: {event: "unresolve"}, class: "btn", form: {data: {turbo_confirm: "Mark this reservation as unresolved? Use this when items are missing or need staff follow-up."}} %>

    <% elsif @reservation.manager.can? :resolve %>
      <%= button_to "Resolve", admin_reservation_status_path(@reservation), method: :patch, params: {event: "resolve"}, class: "btn", form: {data: {turbo_confirm: "Mark this reservation as returned? Any usage fees will be charged to the member."}} %>
    <% end %>

  <% end %>
<% end %>

<div class="columns">
  <div class="column col-4 col-sm-12">
    <div class="panel item-panel">
      <div class="panel-body">
        <ul class="item-stats">
          <%= icon_stat "user", link_to(preferred_or_default_name(@reservation.member), admin_member_path(@reservation.member)), title: "reserved by" %>
          <%= icon_stat "clock", @reservation.started_at.to_formatted_s(:month_day_year), title: "pickup" %>
          <%= icon_stat "corner-down-left", @reservation.ended_at.to_formatted_s(:month_day_year), title: "return" %>
          <%= icon_stat "info", @reservation.status, title: "status" %>

          <% if @reservation.pickup_event %>
            <%= icon_stat "clock", format_reservation_event(@reservation.pickup_event), title: "pickup" %>
          <% end %>
          <% if @reservation.dropoff_event %>
            <%= icon_stat "corner-down-left", format_reservation_event(@reservation.dropoff_event), title: "dropoff" %>
          <% end %>
        </ul>
      </div>
    </div>
  </div>

  <div class="column col-sm-12 col-8">

    <% if Reservation.statuses.values_at(:requested, :approved, :building).include?(@reservation.status) %>
      <%= render partial: "admin/reservations/reservation_policies_warnings", locals: {reservation: @reservation} %>
    <% end %>

    <ul class="tab">
      <%= tab_link "Reservation", admin_reservation_path(@reservation) %>
      <%= tab_link "Items", admin_reservation_loans_path(@reservation) %>
      <%= tab_link "Questions", admin_reservation_questions_path(@reservation) %>
      <%= tab_link("Review", edit_admin_reservation_review_path(@reservation), badge: true) if @reservation.manager.can?(:approve) %>
      <%= tab_link("Review Notes", admin_reservation_review_path(@reservation)) if @reservation.notes? %>
    </ul>

    <%= yield %>
</div>
