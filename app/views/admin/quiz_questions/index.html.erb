<% content_for :header do %>
  <%= index_header "Signup Quiz" do %>
    <%= link_to "New question", new_admin_quiz_question_path, class: "btn" %>
  <% end %>
<% end %>

<p>
  Members answer these questions right after watching the policy presentation, during signup and renewal.
  They see the correct answer either way. The counts show how often each answer gets picked, which is a good
  way to spot a slide that isn't landing.
</p>

<% if @quiz_questions.empty? %>
  <%= empty_state "No quiz questions yet", subtitle: "Add one and members will see the quiz after the policy presentation." do %>
    <%= link_to "New question", new_admin_quiz_question_path, class: "btn btn-primary" %>
  <% end %>
<% else %>
  <table class="table">
    <thead>
      <tr>
        <th>#</th>
        <th>Question</th>
        <th>Answers</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @quiz_questions.each do |question| %>
        <tr class="<%= "text-gray" if question.archived? %>">
          <td><%= question.position %></td>
          <td>
            <%= question.content %>
            <% if question.archived? %>
              <br><small>Archived <%= l(question.archived_at.to_date) %></small>
            <% end %>
          </td>
          <td>
            <ul class="quiz-choice-list">
              <% question.choices.each do |choice| %>
                <li>
                  <% if choice.correct? %>
                    <strong><%= choice.content %></strong>
                  <% else %>
                    <%= choice.content %>
                  <% end %>
                  <span class="label"><%= pluralize(choice.times_chosen, "pick") %></span>
                </li>
              <% end %>
            </ul>
          </td>
          <td>
            <%= link_to "Edit", edit_admin_quiz_question_path(question) %>
            <% if question.archived? %>
              <%= button_to "Unarchive", unarchive_admin_quiz_question_path(question), method: :patch, class: "btn btn-link" %>
            <% else %>
              <%= button_to "Archive", archive_admin_quiz_question_path(question), method: :patch, data: {turbo_confirm: "Archive this question? Members won't see it anymore."}, class: "btn btn-link" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
