<% content_for :header do %>
  <%= index_header "Search Items" %>
<% end %>

<div class="items-search">
  <%= form_with url: search_admin_items_path, method: :get, local: true, class: "filters-form" do %>
    <div class="columns">
      <div class="column col-12">
        <%= label_tag :query, "Search", class: "form-label" %>
        <%= text_field_tag :query, params[:query], placeholder: "", autocomplete: "off", class: "form-input" %>
        <div class="form-input-hint">Scope search to specific fields using brand:dewalt or name:"power drill")</div>
      </div>
      <div class="column col-9">
        <fieldset class="form-fieldset">
          <legend class="text-normal">Status</legend>
            <% selected_statuses = params.dig(:q, :status_in) || %w[active pending maintenance] %>
            <% Item.statuses.keys.each do |status| %>
              <%= label_tag "q_status_in_#{status}", class: "form-checkbox form-inline #{"disabled" if @status_filter_ignored}" do %>
                <%= check_box_tag "q[status_in][]", status, selected_statuses.include?(status), id: "q_status_in_#{status}", disabled: @status_filter_ignored %>
                <i class="form-icon"></i> <%= status.humanize %>
              <% end %>
            <% end %>
            <% if @status_filter_ignored %>
              <% selected_statuses.each do |status| %>
                <%= hidden_field_tag "q[status_in][]", status %>
              <% end %>
            <% end %>
        </fieldset>
      </div>
      <div class="column col-3 search-button-wrapper">
        <%= submit_tag "Search", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>

  <% if @items.any? %>
    <div class="column col-12 mt-2">
      <table class="table">
        <tr>
          <th>Image</th>
          <th><%= sort_link(@q, :number, "Number") %></th>
          <th><%= sort_link(@q, :status, "Status") %></th>
          <th><%= sort_link(@q, :name, "Name") %></th>
          <th><%= sort_link(@q, :size, "Size / Strength") %></th>
          <th><%= sort_link(@q, :active_holds_count, "Holds") %></th>
          <th><%= sort_link(@q, :brand, "Brand / Model") %></th>
          <th>Category</th>
        </tr>
        <% @items.each do |item| %>
          <tr>
            <td>
              <% if item.image.attached? %>
                <%= link_to admin_item_path(item) do %>
                  <%= image_tag item_image_url(item.image, resize_to_limit: [60, 60]) %>
                <% end %>
              <% end %>
            </td>
            <td>
              <%= link_to item.complete_number, admin_item_path(item) %>
            </td>
            <td>
              <%= item.status.humanize %>
            </td>
            <td>
              <%= link_to item.name, admin_item_path(item) %>
            </td>
            <td>
              <%= [item.size, item.strength].select(&:present?).join(" / ") %>
            </td>
            <td>
              <%= item.active_holds_count %>
            </td>
            <td>
              <%= [item.brand, item.model].select(&:present?).join(" / ") %>
            </td>
            <td>
              <%= item.categories.map(&:name).join(", ") %>
            </td>
          </tr>
        <% end %>
      </table>
    </div>
    <%== pagy_bootstrap_nav(@pagy) %>
  <% else %>
    <%= empty_state "There are no items that match the current filters!" %>
  <% end %>
</div>
