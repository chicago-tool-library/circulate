<div class="columns">
  <div class="column col-8 col-sm-12 col-mx-auto">
    <% if policy_deck_url %>
      <div class="instructions">
        <p class="main">Please read through this short presentation about our policies.</p>
        <p class="sub">Use the arrows to move through the slides. To make the presentation bigger, move your mouse over it and click the two arrows in the bottom-right corner. When you're done, click <em>Continue</em> to go to the next step.</p>
        <div class="divider"></div>
      </div>

      <div class="policy-deck">
        <div class="policy-deck-player">
          <iframe src="<%= policy_deck_embed_url %>" title="<%= document.name %> presentation" loading="lazy" allowfullscreen allow="fullscreen"></iframe>
        </div>
        <p class="policy-deck-popout">
          <%= link_to policy_deck_url, target: "_blank", rel: "noopener noreferrer" do %>
            <%= feather_icon "external-link" %> Open a new tab to make the presentation larger
          <% end %>
        </p>
        <% if document.google_doc? %>
          <p class="policy-deck-text">
            <%= link_to "Read the full text of our policies", document.google_doc_url, target: "_blank", rel: "noopener noreferrer" %>
          </p>
        <% else %>
          <details class="policy-deck-text">
            <summary>Read the full text of our policies</summary>
            <div class="rich-text">
              <%= document.body %>
            </div>
          </details>
        <% end %>
      </div>
    <% else %>
      <div class="instructions">
        <p class="main">Please read through the following description of our policies.</p>
        <p class="sub">When you're done, click <em>Continue</em> to go on to the next step.</p>
        <div class="divider"></div>
      </div>

      <%= render "documents/content", document: document %>
    <% end %>

    <p>
      <%= link_to "Continue", continue_url, class: "btn btn-primary btn-block btn-lg" %>
    </p>
  </div>
</div>
