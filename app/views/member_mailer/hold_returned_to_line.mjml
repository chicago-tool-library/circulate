<mj-section>
  <mj-column padding-top="20px">
    <mj-image src="<%= image_url "logo.jpg" %>" width="100px" />
  </mj-column>
</mj-section>
<mj-section>
  <mj-column>
    <mj-text font-size="36px" line-height="28px" font-weight="bold" align="center"><%= @subject %></mj-text>
  </mj-column>
</mj-section>

<mj-section>
  <mj-column>
    <mj-text>
      <p>We let you know that <strong><%= @item.name %> (<%= @item.complete_number %>)</strong> was ready for you, but a librarian has since lent it to another member. Sorry about that!</p>

      <p>You're still first in line. As soon as it comes back, your hold will be ready again and we'll let you know.</p>

      <% if @appointment_change == :cancelled %>
        <p>Your appointment on <%= @appointment_when %> was only for this item, so we've cancelled it.</p>
      <% elsif @appointment_change == :removed %>
        <p>We've taken it off your appointment on <%= @appointment_when %>. The rest of that appointment is unchanged.</p>
      <% end %>
    </mj-text>
  </mj-column>
</mj-section>
