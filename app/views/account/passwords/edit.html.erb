<% content_for :header do %>
  <%= section_header "Editing Password" %>
<% end %>

<%= form_with(model: @user, url: {action: "update"}, builder: SpectreFormBuilder) do |f| %>
  <%= password_visibility_field(f, :current_password, autocomplete: "off") %>
  <%= password_visibility_field(f, :password, label: "New password", autocomplete: "off") %>
  <%= password_visibility_field(f, :password_confirmation, label: "Confirm new password") %>
  <%= f.actions do %>
    <%= f.submit "Update Password" %>
  <% end %>
<% end %>
