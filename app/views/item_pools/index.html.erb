<div class="items-index">
  <%= render "shared/current_reservation_header" %>
  <div class="columns">
    <div class="column col-sm-12 col-3 category-nav" data-controller="collapse">
      <button class="btn toggle-categories" data-collapse-target="button" data-action="collapse#toggle" class="btn">Show Categories</button>
      <div class="categories" data-collapse-target="content">
        <h5>Categories</h5>
        <%= category_tree_nav(@categories, @category, :visible_reservable_items_count) %>
      </div>
    </div>

    <div class="column col-9-sm col-12-xs">
      <div class="items-summary">
        <div>
          Viewing
          <% if @category %>
            <strong><%= pluralize @pagy.count, "type" %></strong> of items assigned to
            <span class="chip">
              <%= @category.name %>
              <%= link_to "", {tag: nil}, :class => "btn btn-clear", "aria-label" => "Clear filter", :role => "button", :title => "Clear filter" %>
            </span>
          <% else %>
            <strong><%= pluralize @pagy.count, "type" %> of items</strong>
          <% end %>
        </div>
      </div>

      <% if @item_pools.any? %>
      <section>
        <ul class="items-list">
          <% @item_pools.each do |item_pool| %>
            <li id="item-pool-<%= item_pool.id %>" class="item-container" tabindex="0" aria-labelledby="item-pool-name-<%= item_pool.id %>">
              <%= tag.div class: "item-image" do %>
                <% if item_pool.image.attached? %>
                  <%= link_to item_pool_path(item_pool) do %>
                    <%= image_tag item_image_url(item_pool.image, resize_to_limit: [200, 140]), alt: item_pool.name %>
                  <% end %>
                <% else %>
                  <div class="item-image-placeholder"></div>
                  <span class="visually-hidden"><%= item_pool.name %></span>
                <% end %>
              <% end %>

              <div class="item-content">
                <%= tag.div class: "item-info" do %>
                  <strong><%= link_to item_pool.name, item_pool_path(item_pool), class: "item-name", id: "item-pool-name-#{item_pool.id}" %></strong>
                  (<%= item_pool.max_reservable_quantity %>)
                <% end %>

                <%= tag.div class: "item-categories" do %>
                  <% item_pool.categories.each do |category| %>
                    <%= link_to category.name, item_pools_path(category: category.id) %>
                  <% end %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
        <%== pagy_bootstrap_nav(@pagy) %>
      </section>
      <% elsif @category %>
        <%= empty_state "There are no item pools in this category", subtitle: "Create one?" do %>
          <%= link_to "Add an Item Pool to #{@category.name}", new_item_pool_path(category_id: @category.id), class: "btn btn-primary" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
